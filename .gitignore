# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# IDE
.idea/

# AI tooling: skill packs (.agents/, .claude/) are intentionally tracked to
# document the agentic-coding workflow; ignore only generated bytecode.
.agents/skills/**/__pycache__/

# env files (never commit secrets to a public repo)
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# build artifacts
*.apk
*.aab
